# Normalize line endings to LF in repo
* text=auto eol=lf

# Treat images and other binaries correctly
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

# Shell scripts should be LF
*.sh text eol=lf

# Reduce noisy diffs
package-lock.json -diff
pnpm-lock.yaml -diff
yarn.lock -diff

